
# ============================================
# TOPIQ — Environment Config
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB — use your Atlas connection string OR local URI
# Local:  mongodb://localhost:27017/ssp
# Atlas:  mongodb+srv://<username>:<password>@cluster.mongodb.net/ssp?retryWrites=true&w=majority
MONGO_URI=

# JWT — must be a long, random secret string
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Gemini API Key — get from https://aistudio.google.com/app/apikey
# Leave as-is to use MOCK AI responses (app still works without a real key)
GEMINI_API_KEY=
GROQ_API_KEY=your-groq-api-key-here
# Get a free key at console.groq.com — used as fallback when Gemini returns 503/429

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
