

# Server
PORT=5000
NODE_ENV=development

# MongoDB — use your Atlas connection string OR local URI
# Local:  mongodb://localhost:27017/ssp
# Atlas:  mongodb+srv://<username>:<password>@cluster.mongodb.net/ssp?retryWrites=true&w=majority
MONGO_URI=
# JWT — must be a long, random secret string
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI API Key — get from https://platform.openai.com/api-keys
# Leave as-is to use MOCK AI responses (app still works without a real key)
OPENAI_API_KEY=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
